import java.util.LinkedList;
import java.util.Queue;
import java.util.Scanner;

public class Main {


    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();
        int M = sc.nextInt();

        int[][] map = new int[N][M]; // 미로 0: 이동불가/ 1: 이동가능
        for (int i = 0; i < N; i++) {
            String srt = sc.next();
            for (int j = 0; j < M; j++)
                map[i][j] = srt.charAt(j) - '0';
        }
//      bfs
        int[] dx = {1, -1, 0, 0};
        int[] dy = {0, 0, 1, -1};

        boolean[][] used = new boolean[N][M];

        Queue<int[]> q = new LinkedList<>();
        q.add(new int[] {0, 0, 1});
        used[0][0] = true;

        while (!q.isEmpty()) {
            int[] tmp = q.poll(); // x, y, 이동횟수

            if (tmp[0] == N-1 && tmp[1] == M-1) {
                System.out.println(tmp[2]);
                return;
            }

            for (int i=0; i<4; i++) {
                int nx = tmp[0] + dx[i];
                int ny = tmp[1] + dy[i];

                if (nx < 0 || nx >= N || ny < 0 || ny >= M) continue;

                if (map[nx][ny] == 1 && !used[nx][ny]) {
                    q.add(new int[] {nx, ny, tmp[2] + 1});
                    used[nx][ny] = true;
                }

            }

        }
    }

}
